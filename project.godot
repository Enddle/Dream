; Project was converted by built-in tool to Godot 4.0
config_version=5

[application]

config/name="Dream"
run/main_scene="res://StartingScreen.tscn"
config/icon="res://icon.png"

[autoload]

AuH="*res://Scenes/AutoLoad/AudioHelper.tscn"
DynamicColor="*res://Scenes/AutoLoad/DynamicColor.tscn"
Connect="*res://Scenes/AutoLoad/Connect.gd"
SceneHelper="*res://Scenes/AutoLoad/SceneHelper.tscn"
Hint="*res://Scenes/AutoLoad/Hint.tscn"
TA="*res://Scenes/AutoLoad/TouchAnimOverlay.tscn"

[display]

window/size/viewport_width=2266
window/size/viewport_height=1488
window/size/always_on_top=true
window/size/window_width_override=755
window/size/window_height_override=496
window/stretch/mode="2d"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/enable_pause_aware_picking=true

[rendering]

shading/overrides/force_vertex_shading.mobile=false
environment/defaults/default_environment="res://default_env.tres"
